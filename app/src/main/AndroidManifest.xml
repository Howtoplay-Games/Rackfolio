<?xml version="1.0" encoding="utf-8"?>
<!--
  PortProof declares no permissions itself and its own code makes no network calls. Libraries merge in:
  - com.android.vending.BILLING, INTERNET, ACCESS_NETWORK_STATE: Google Play Billing and the Google
    logging component it depends on (see ARCHITECTURE.md, ADR-011).
  - USE_BIOMETRIC, USE_FINGERPRINT: androidx.biometric, for fingerprint or face unlock.
  CAMERA is added with the QR scanner in Phase 2 and requested at the point of use.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <application
        android:name=".PortProofApplication"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:enableOnBackInvokedCallback="true"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.PortProof"
        tools:targetApi="33">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.PortProof.Splash"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>

</manifest>
