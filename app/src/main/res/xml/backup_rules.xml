<?xml version="1.0" encoding="utf-8"?>
<!-- Android 8–11 equivalent of data_extraction_rules.xml (cloud backup scope). -->
<full-backup-content>
    <include domain="database" path="." requireFlags="clientSideEncryption" />
    <include domain="file" path="datastore/" requireFlags="clientSideEncryption" />
    <exclude domain="file" path="datastore/app_lock.preferences_pb" />
    <exclude domain="file" path="datastore/billing.preferences_pb" />
</full-backup-content>
